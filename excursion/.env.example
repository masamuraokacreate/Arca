# Discord Bot トークン（Discord Developer Portal から取得）
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# 自動投稿先の専用テキストチャンネルID
DISCORD_CHANNEL_ID=1234567890123456789

# Arca 休日APIエンドポイント
# Vite開発サーバー利用時: http://localhost:5173/api/v1/schedule/next-holidays
# スタンドアロンAPIサーバー利用時: http://localhost:3000/api/v1/schedule/next-holidays
ARCA_API_URL=http://localhost:5173/api/v1/schedule/next-holidays

# タイムゾーン（日本時間）
TIMEZONE=Asia/Tokyo

# 定期監視タスクのポーリング間隔（分）
CHECK_INTERVAL_MINUTES=5

# デフォルト投稿スタイル（D: コードブロックワンタップコピー）
DEFAULT_STYLE=D
